DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-your-endpoint.neon.tech/neondb?sslmode=require"

# Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
COOKIE_NAME="gt_token"

# Cloudinary (avatar/cover photo uploads)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend (password reset emails — fallback: console.log)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="noreply@yourdomain.com"

# GeoDB Cities API (via RapidAPI — 1000 req/day free)
RAPIDAPI_KEY="your-rapidapi-key"

# OpenTripMap (free, no key needed)
# OPENTRIPMAP_API_KEY=""

# App URL (for reset email links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
